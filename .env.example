# Persistent Node.js service. Copy to .env.local; never commit real credentials.
APP_URL=http://127.0.0.1:3000
SQLITE_PATH=./data/brightloop.sqlite
LOCAL_STORAGE_PATH=./data/uploads
BACKUP_PATH=./data/backups
# Standard SMTP; Gmail uses smtp.gmail.com, 587, false and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Generate a random secret of at least 32 characters. Never use a URL parameter.
CRON_SECRET=
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MS=3600000
BILLING_CATCHUP_LIMIT=100
RENEWAL_REMINDER_DAYS=7
OVERDUE_REMINDER_DAYS=7
OVERDUE_GRACE_DAYS=0
DELIVERY_RETENTION_DAYS=90
# Absolute sessions: 24 hours; idle sessions: 30 minutes; single-use tokens: 30 minutes.
# Operator must define business-record retention before public launch.
BUSINESS_RETENTION_DETAILS=
APP_OPERATOR=
SUPPORT_EMAIL=
JURISDICTION=
# Explicit seed command only. Must be a new filename beginning demo-.
DEMO_SQLITE_PATH=./data/demo-brightloop.sqlite
# Optional development password satisfying the account password policy.
# If omitted, the seed command prints independent random development passwords once.
DEMO_PASSWORD=
